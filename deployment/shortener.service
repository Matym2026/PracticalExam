[Unit]
Description=AWS URL Shortener (FastAPI)
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/PracticalExam/backend
EnvironmentFile=/home/ec2-user/PracticalExam/.env
ExecStart=/home/ec2-user/PracticalExam/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
